{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
{{#if push}}
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/auto-commit.sh\""
          }
        ]
      }
    ],
{{/if}}
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/auto-stage.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "EnterWorktree|Agent|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-worktree.sh\""
          }
        ]
      }
    ]
  }
}
